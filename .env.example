# ==============================================================================
# AEGISLEDGER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your deployment
# ==============================================================================

# Application Runtime Profile (local, dev, staging, prod)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SPRING_THREADS_VIRTUAL_ENABLED=true

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aegis_ledger
DB_USER=postgres
DB_PASSWORD=aegissecretpassword
POSTGRES_PORT=5432

# In-Memory Cache (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# Event Streaming (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092

# Real-Time Fraud Engine Parameters
FRAUD_VELOCITY_WINDOW_SECONDS=60
FRAUD_MAX_TRANSACTIONS_PER_WINDOW=5
FRAUD_LARGE_AMOUNT_THRESHOLD=100000.00

# Transactional Outbox Worker
OUTBOX_WORKER_FIXED_RATE_MS=1000

# JVM Tuning Parameters
JAVA_OPTS=-XX:+UseZGC -XX:+ZGenerational -XX:+EnableDynamicAgentLoading -Xms512m -Xmx2g
