# ==============================================================================
# AEGISLEDGER - GIT ATTRIBUTES
# ==============================================================================

# Default behavior: treat all files as text and normalize to LF
* text=auto eol=lf

# Windows scripts & batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
mvnw.cmd text eol=crlf

# Shell scripts and wrappers require LF
*.sh text eol=lf
mvnw text eol=lf

# Documentation and configuration files
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# Java source code
*.java text diff=java eol=lf

# Binary files
*.jar binary
*.war binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
